{% extends 'base.html.twig' %}

{% block title %}FuPrAn - Station - {{ station.name }}{% endblock %}

{% block breadcrumbs %}
    <twig:Station:BreadCrumbs station="{{ station }}" />
{% endblock %}

{% block body %}
    <div class="row row-cols-2 mb-4 g-4">
        <div class="col">
            <div class="mb-4">
                <twig:Station:Info station="{{ station }}" />
            </div>

            <twig:Station:DayPriceOverview station="{{ station }}" requestedDay="{{ day }}" query="{{ app.request.query.all }}" />
        </div>

        <div class="col">
            {% if station.latestPrice %}
            <div class="card mb-4">
                <div class="card-header h5">
                    Latest Price Data: {{ station.latestPrice.day|date('d/m/Y') }}
                </div>

                <div class="card-body">
                    <twig:Station:LatestPrices station="{{ station }}" />
                </div>
            </div>
            {% endif %}

            <twig:Station:Nearby station="{{ station }}" />
        </div>
    </div>

    <div class="row row-cols-1 mb-4">
        <div class="col">
            <turbo-frame id="station-charts">
                <h5>Price history{% if requestedRange %} ({{ requestedRange.from|date('Y-m-d') }} – {{ requestedRange.to|date('Y-m-d') }}){% else %} (recent){% endif %}</h5>
                <twig:DateRangePicker range="{{ range }}" frame="station-charts" routeName="app_station_show" :routeParams="{id: station.id}" />
                <twig:Station:ChartTabs station="{{ station }}" range="{{ requestedRange }}" />
            </turbo-frame>
        </div>
    </div>
{% endblock %}
