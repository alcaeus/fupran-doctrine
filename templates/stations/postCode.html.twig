{% extends 'base.html.twig' %}

{% block title %}FuPrAn - Stations in post code {{ postCode }}{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_stations') }}">Stations</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ postCode }}</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    {% if stations is empty %}
        <div class="alert alert-warning" role="alert">No stations found!</div>
    {% else %}
        <twig:PostCode:Map stations="{{ stations }}" />
    {% endif %}
{% endblock %}
