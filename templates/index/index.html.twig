{% extends 'base.html.twig' %}

{% block title %}FuPrAn{% endblock %}

{% block body %}
    <div id="stats" class="row row-cols-3 gy-4">
        <div class="col">
            <twig:DailyAggregateCard aggregate="{{ latestDailyAggregate.diesel }}" />
        </div>
        <div class="col">
            <twig:DailyAggregateCard aggregate="{{ latestDailyAggregate.e5 }}" />
        </div>
        <div class="col">
            <twig:DailyAggregateCard aggregate="{{ latestDailyAggregate.e10 }}" />
        </div>
        <div class="col-12">
            <turbo-frame id="dashboard-charts">
                <twig:DateRangePicker range="{{ range }}" frame="dashboard-charts" routeName="app_homepage" />
                <twig:PriceOverviewCard recentDailyAggregates="{{ recentDailyAggregates }}" />
                {% if recentDailyAggregates is empty %}
                    <div class="alert alert-info mt-3" role="alert">No price data available for the selected range.</div>
                {% endif %}
            </turbo-frame>
        </div>
    </div>
{% endblock %}
