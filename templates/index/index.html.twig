{% extends 'base.html.twig' %}

{% block title %}FuPrAn{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-5 mb-4">
            {# The map grows to the height of the column next to it #}
            <div class="card h-100">
                <div class="card-header">Select a region or post code</div>
                <div class="card-body d-flex flex-column">
                    <twig:PostCode:AreaMap selectedArea="{{ selection.area }}" />
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <turbo-frame id="home">
                {% if selection.area is not null %}<div data-area="{{ selection.area }}" hidden></div>{% endif %}

                {# Everything that depends on the day, so that choosing a day in the chart does not reload the chart #}
                <turbo-frame id="home-day">
                {{ include('selection/_area.html.twig', {route: 'app_homepage', params: {}, frame: 'home'}) }}

                <div class="row mb-4">
                    {% for fuel in fuels %}
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header">{{ fuel.displayValue }} on {{ day|date('d/m/Y') }}</div>
                                <div class="card-body">
                                    {% if dailyAggregate is null %}
                                        <p class="text-muted mb-0">No prices in this area.</p>
                                    {% else %}
                                        <twig:DailyAggregateCard aggregate="{{ dailyAggregate }}" fuel="{{ fuel }}" />
                                    {% endif %}
                                </div>
                                <div class="card-footer">
                                    <a href="{{ path('app_map', {fuel: fuel.value}|merge(selection.toQuery)) }}" data-turbo-frame="_top">Show on map</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <twig:DateRangePicker range="{{ selection.range }}" frame="home" routeName="app_homepage" :queryParams="selection.toQuery({from: null, to: null})" today="{{ latestDay }}" />
                </turbo-frame>

                <div class="card">
                    <div class="card-body">
                        <twig:Chart:DailyAggregate:WeightedAverageHistory
                            aggregates="{{ recentDailyAggregates }}"
                            data-controller="chart-day-link"
                            data-chart-day-link-url-value="{{ path('app_homepage') }}"
                            data-chart-day-link-frame-value="home-day"
                        />
                        {% if recentDailyAggregates is empty %}
                            <div class="alert alert-info mt-3 mb-0" role="alert">No price data available for the selected range.</div>
                        {% endif %}
                    </div>
                </div>
            </turbo-frame>
        </div>
    </div>
{% endblock %}
