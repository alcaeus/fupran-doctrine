{% set data = this.data %}
{% set isPostCode = area|length == 5 %}
<div data-area="{{ area }}">
    <h6>{{ isPostCode ? 'Post code ' ~ area : 'Post codes ' ~ area ~ 'xxx' }}</h6>
    {% if data is null %}
        <p class="text-muted">No prices in this area.</p>
    {% else %}
        <dl>
            <dt>Average Price</dt>
            <dd><twig:Price price="{{ data.weightedAveragePrice }}" /></dd>
            <dt>Lowest Price</dt>
            <dd><twig:Price price="{{ data.lowestPrice }}" /></dd>
            <dt>Highest Price</dt>
            <dd><twig:Price price="{{ data.highestPrice }}" /></dd>
        </dl>
    {% endif %}
    {% if isPostCode %}
        <a class="d-block" href="{{ path('app_postcode_card', {fuel: fuel.value, day: day|date('Y-m-d'), region: area|slice(0, 2)}) }}">&larr; Post codes {{ area|slice(0, 2) }}xxx</a>
    {% endif %}
    <a class="d-block" href="{{ path('app_postcode_card', {fuel: fuel.value, day: day|date('Y-m-d')}) }}">&larr; All of Germany</a>
</div>
