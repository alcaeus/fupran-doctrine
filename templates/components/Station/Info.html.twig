{% props station %}

<div class="card">
    <div class="card-header h5">
        <twig:Station:Favorite station="{{ station }}" control="true" />
        {{ station.name }}
    </div>

    <twig:Station:Map station="{{ station }}" />

    <div class="card-body">
        <h6 class="card-subtitle text-muted">{{ station.brand }}</h6>
        <address class="card-text">
            {{ station.address.street }} {{ station.address.houseNumber }}<br />
            <a href="{{ path('app_stations_postCode', {postCode: station.address.postCode}) }}">{{ station.address.postCode }}</a> {{ station.address.city }}
        </address>
    </div>
</div>
