{% if station.latestPrice is not null %}
    {% if station.latestPrice.diesel %}
        <twig:Station:LatestPriceData dailyPrice="{{ station.latestPrice.diesel }}" /><br>
    {% endif %}

    {% if station.latestPrice.e5 %}
        <twig:Station:LatestPriceData dailyPrice="{{ station.latestPrice.e5 }}" /><br>
    {% endif %}

    {% if station.latestPrice.e10 %}
        <twig:Station:LatestPriceData dailyPrice="{{ station.latestPrice.e10 }}" /><br>
    {% endif %}
{% else %}
    <div class="alert alert-info" role="alert">
        No latest prices available for this station.
    </div>
{% endif %}
