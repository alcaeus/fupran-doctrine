<turbo-frame id="station-day">
    {% set day = this.day %}
    {% if day is not null %}
        <div class="d-flex align-items-center gap-2 mb-2">
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_station_show', {id: this.station.id}|merge(this.queryForDay(this.previousDay))) }}" data-turbo-action="advance" aria-label="Previous day">&laquo;</a>
            <form method="get" action="{{ path('app_station_show', {id: this.station.id}) }}" data-turbo-action="advance" class="d-flex gap-1">
                {% for name, value in this.query %}
                    {% if name != 'day' and value is not iterable %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}">
                    {% endif %}
                {% endfor %}
                <div class="input-group input-group-sm">
                    <input type="date" class="form-control" name="day" value="{{ day|date('Y-m-d') }}" max="{{ this.today|date('Y-m-d') }}" required aria-label="Day">
                    <button type="submit" class="btn btn-primary input-group-btn">Show</button>
                </div>
            </form>
            {% if this.nextDay %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_station_show', {id: this.station.id}|merge(this.queryForDay(this.nextDay))) }}" data-turbo-action="advance" aria-label="Next day">&raquo;</a>
            {% else %}
                <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">&raquo;</span>
            {% endif %}
        </div>
    {% endif %}

    {% if this.dailyPrices is empty %}
        <div class="alert alert-info" role="alert">
            No price changes recorded{% if day %} on {{ day|date('Y-m-d') }}{% endif %}. The price of the previous day carries over.
        </div>
    {% else %}
        <twig:Chart:Station:DayPriceOverview dailyPrices="{{ this.dailyPrices }}" />
    {% endif %}
</turbo-frame>
