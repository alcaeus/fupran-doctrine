<form method="get" action="{{ path(this.routeName, this.routeParams) }}" data-turbo-frame="{{ this.frame }}" data-turbo-action="advance" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="{{ this.frame }}_from" class="form-label mb-0">From</label>
        <input type="date" class="form-control form-control-sm" id="{{ this.frame }}_from" name="from" value="{{ this.range.from|date('Y-m-d') }}" required{% if this.min %} min="{{ this.min|date('Y-m-d') }}"{% endif %} max="{{ this.max|date('Y-m-d') }}">
    </div>
    <div class="col-auto">
        <label for="{{ this.frame }}_to" class="form-label mb-0">To</label>
        <input type="date" class="form-control form-control-sm" id="{{ this.frame }}_to" name="to" value="{{ this.range.to|date('Y-m-d') }}" required{% if this.min %} min="{{ this.min|date('Y-m-d') }}"{% endif %} max="{{ this.max|date('Y-m-d') }}">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">Show</button>
    </div>
    <div class="col-auto">
        <div class="btn-group btn-group-sm" role="group" aria-label="Presets">
            {% for label, preset in this.presets %}
                <a class="btn btn-outline-secondary" href="{{ path(this.routeName, this.routeParams|merge(preset)) }}" data-turbo-frame="{{ this.frame }}" data-turbo-action="advance">{{ label }}</a>
            {% endfor %}
        </div>
    </div>
</form>
