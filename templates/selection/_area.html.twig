{# Where the selection is: all of Germany, a region or a post code, each leading to the selection with it as its area #}
<nav aria-label="Area" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item{{ selection.area is null ? ' active' }}">
            {% if selection.area is null %}Germany{% else %}<a href="{{ path(route, params|merge(selection.toQuery({area: null}))) }}" data-turbo-action="advance">Germany</a>{% endif %}
        </li>
        {% if selection.area is not null %}
            <li class="breadcrumb-item{{ not selection.isPostCode ? ' active' }}">
                {% if selection.isPostCode %}<a href="{{ path(route, params|merge(selection.toQuery({area: selection.region}))) }}" data-turbo-action="advance">{{ selection.region }}xxx</a>{% else %}{{ selection.region }}xxx{% endif %}
            </li>
        {% endif %}
        {% if selection.isPostCode %}
            <li class="breadcrumb-item active">{{ selection.area }}</li>
        {% endif %}
    </ol>
</nav>
